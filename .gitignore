# secrets
.env

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# REAL ORIGINALS and unredacted previews: never committed, by location.
# (raw documents live in data/private/raw/, unredacted preview pages in data/private/preview/)
data/private/

# run artifacts: keep the directory, not the contents
# (data/pages/ is NOT ignored: normalized + redacted pages are part of the dataset)
outputs/*
!outputs/.gitkeep

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# Augraphy writes its generated textures here when run from the repo root
augraphy_cache/
