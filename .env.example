# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Any OpenAI-compatible chat-completions endpoint with vision support works.

# --- Default example: Gemini via Google AI Studio (OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-ai-studio-api-key
# Model ids get retired: gemini-2.5-flash answered 404 "no longer available to new users" on
# 2026-10-06. List what your key can call with GET <LLM_BASE_URL>models (Authorization: Bearer
# <key>). gemini-3.5-flash was verified working that day; pick a vision-capable model.
LLM_MODEL=gemini-3.5-flash

# --- Alternative: local Ollama (uncomment, and comment out the Gemini block above) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5vl:7b

# --- Pre-labeling (scripts/prelabel.py): a DIFFERENT model drafts labels that a human verifies ---
# Used only to draft ground truth, through the same client class as the extractor. It must not be
# the extractor's own model: the script refuses that (a draft by the model that is later evaluated
# would turn its own mistakes into ground truth). Example: Claude Haiku via Anthropic's
# OpenAI-compatible endpoint. That endpoint IGNORES response_format and reasoning_effort, so the
# schema goes into the prompt (PRELABEL_STRUCTURED_MODE=json_object, the default here); it takes
# images up to ~5 MB (the script sends derivatives under 4.5 MB) and downscales above ~1568 px.
# Prices are USD per 1M tokens, copied from the vendor's pricing page.
PRELABEL_BASE_URL=https://api.anthropic.com/v1/
PRELABEL_API_KEY=your-anthropic-api-key
PRELABEL_MODEL=claude-haiku-4-5
PRELABEL_PRICE_INPUT_PER_MTOK=1.00
PRELABEL_PRICE_OUTPUT_PER_MTOK=5.00
# optional (values shown are the defaults)
# PRELABEL_STRUCTURED_MODE=json_object
# PRELABEL_IMAGE_MAX_LONG_EDGE=1568
# PRELABEL_MAX_PAGES=15        # a longer bundle must be split first (page_range in the manifest)
# PRELABEL_MAX_TOKENS=8000
# PRELABEL_MAX_RUN_COST_USD=   # stop a pre-labeling run once it has spent this much (needs prices)

# --- Cost accounting: USD per 1M tokens. Copy from the provider's pricing page. ---
# Set to 0 for local models (the cost is then reported as 0 and MAX_RUN_COST_USD cannot be used).
# Paid-tier list prices on ai.google.dev/gemini-api/docs/pricing, rechecked 2026-10-07 (the output
# price includes thinking tokens): gemini-3.5-flash 1.50 in / 9.00 out (the values below);
# gemini-3.6/3.7/3.8-flash 0.75 / 3.75 until 2026-12-31, then 1.50 / 7.50. If you change
# LLM_MODEL, change these with it. Google's OpenAI-compatible layer leaves thinking tokens out of
# completion_tokens; the client adds them to the cost. Measured with gemini-3.5-flash on 2026-10-07:
# about $0.08-0.11 per 2-3 page invoice with 30-60 line items.
LLM_PRICE_INPUT_PER_MTOK=1.50
LLM_PRICE_OUTPUT_PER_MTOK=9.00

# --- Run cost cap (optional): batch/eval runs stop cleanly once spend exceeds this many USD ---
# Needs non-zero prices above (settings refuse the combination otherwise). Blank/unset = no cap.
# MAX_RUN_COST_USD=5

# --- Optional tuning (values shown are the defaults) ---
# LLM_TIMEOUT_S=120
# LLM_MAX_RETRIES=4
# LLM_BACKOFF_BASE_S=1.0
# LLM_BACKOFF_MAX_S=30.0
# Re-asks when the output is not valid JSON / does not match the schema (0 = never).
# LLM_MAX_REPAIRS=1
# --- Ingestion (scripts/ingest.py): how raw documents become stored pages ---
# INGEST_DPI=200            PDF rasterization
# INGEST_MAX_LONG_EDGE=2400 ceiling of the STORED page (0 = none); elongated pages (long/short >
#                           2.5) are capped by area (~6 MP) instead so receipts keep their width
# INGEST_JPEG_QUALITY=92    pages that come from photos are stored as JPEG

# Longest edge (px) of the page images SENT to the model. Applied in memory at request time to
# the stored page (never modified), so a resolution sweep needs no re-ingest. Elongated pages
# (long/short > 2.5) are capped by area instead, so a thermal receipt keeps its width.
# Unset = send the stored page as is (the stored ceiling is INGEST_MAX_LONG_EDGE, default 2400).
# LLM_IMAGE_MAX_LONG_EDGE=
# Most pages one extraction call may carry (all of a document's pages go in one call). Longer
# documents are refused before any request: split the bundle with page_range in the manifest.
# LLM_MAX_PAGES=15
# Response cache of raw completions, keyed by page-image hashes + prompt + model + endpoint +
# reasoning effort + schema: on | off | refresh (skip reads, overwrite entries). Cache hits cost 0.
# The live smoke check bypasses it unless you pass --cache. Entries hold model output for your
# documents, so the directory is gitignored.
# LLM_CACHE=on
# LLM_CACHE_DIR=outputs/cache
# auto = try json_schema, fall back to json_object | json_schema | json_object
# LLM_STRUCTURED_MODE=auto
# Passed through as reasoning_effort when set (Gemini: none/minimal/low/medium/high).
# Unset = the provider's default. Accepted values differ per provider: Gemini 3.x takes
# minimal/low/medium/high (thinking cannot be turned off there; "none" is for 2.5 models).
# "low" was accepted by gemini-3.5-flash and removed its hidden thinking tokens.
# LLM_REASONING_EFFORT=
