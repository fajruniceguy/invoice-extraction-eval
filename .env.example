# Copy to .env and fill in. .env is gitignored; NEVER commit real keys (tools/secret_scan.py and the
# Claude Code hook in .claude/ refuse a commit that adds one).
# Any OpenAI-compatible chat-completions endpoint with vision support works. Nothing here is
# hardcoded in the code: model, endpoint and prices all come from these variables.
#
# With Docker (`docker compose up -d --wait`) this file, as .env, is the `env_file` of the `api`
# service, so a clean clone needs only LLM_API_KEY filled in. The `eval` service never receives
# it. Only the API server calls the model, and `docker compose run --rm eval` goes through it.
# Without Docker the scripts read .env from the repository root.

# --- The extractor. Default: DeepSeek V4 Flash Vision (exp) through Command Code ---
# Measured on the 25 test documents (results/test-g1, README.md): field accuracy 0.845, about $0.008
# per document at the peak prices below, median 12.5 s per document (docs/demo/m8_sweep.md has the
# dev sweep). List the models your key can call with GET <LLM_BASE_URL>/models.
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek/deepseek-v4-flash-vision-exp
# Strict json_schema is rejected by this provider; json_object works first time and skips a wasted
# request. auto = try json_schema, fall back to json_object | json_schema | json_object |
# prompt (no response_format at all, the schema only in the prompt text).
LLM_STRUCTURED_MODE=json_object
# Passed through as reasoning_effort when set; unset = the provider's default. Accepted values
# differ per provider (this one: off | low | medium | high | xhigh | max). Two runs of the same
# setting differ more than the settings do (docs/eval/noise.md): do not read a difference under
# about 3 accuracy points as a finding.
LLM_REASONING_EFFORT=medium

# --- Cost accounting: USD per 1M tokens, copied from the provider's pricing page ---
# Command Code: $0.15 / $0.60 off-peak, $0.30 / $1.20 at peak (01-04 and 06-10 UTC, Mon-Fri).
# The peak rates are used so every reported cost and the cap below are upper bounds. Set both to
# 0 for a local model (cost is then reported as 0 and MAX_RUN_COST_USD cannot be used).
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=1.20

# --- Run cost cap (optional): batch/eval runs stop cleanly once spend exceeds this many USD ---
# Needs non-zero prices above (the settings refuse the combination otherwise). Blank = no cap.
# In the API server it is a budget for the life of the process, so a second `docker compose run
# --rm eval` starts from what the first spent: `docker compose restart api` resets it. The test
# split costs about $0.20 with an empty cache; cache hits (outputs/cache) cost nothing.
MAX_RUN_COST_USD=0.50

# --- Optional tuning (values shown are the defaults unless noted) ---
LLM_TIMEOUT_S=180             # code default 120; a 3-page reasoning call took up to ~106 s
# LLM_MAX_RETRIES=4
# LLM_BACKOFF_BASE_S=1.0
# LLM_BACKOFF_MAX_S=30.0
# Re-asks when the output is not valid JSON / does not match the schema (0 = never).
# LLM_MAX_REPAIRS=1
# false for models that reject `temperature` (Claude 5.x does).
# LLM_SEND_TEMPERATURE=true
# Most pages one extraction call may carry (all of a document's pages go in one call). Longer
# documents are refused before any request: split the bundle with page_range in the manifest.
# LLM_MAX_PAGES=15
# Longest edge (px) of the page images SENT to the model, applied in memory to the stored page
# (never modified). Unset = send the stored page as is. Elongated pages (long/short > 2.5) are
# capped by area instead so a thermal receipt keeps its width.
# LLM_IMAGE_MAX_LONG_EDGE=
# Response cache of raw completions, keyed by page-image hashes + prompt + model + endpoint +
# reasoning effort + schema: on | off | refresh (skip reads, overwrite entries). A hit costs 0.
# The directory holds model output for your documents, so it is gitignored.
# LLM_CACHE=on
# LLM_CACHE_DIR=outputs/cache

# --- Validation and abstention ---
# An extracted field or row whose final confidence is below this is abstained. A placeholder: the
# capped confidences never go below 0.5, so 0.3 never fires (docs/eval/calibration.md). A value its
# own evidence contradicts is abstained whatever its confidence.
# ABSTAIN_BELOW=0.3

# --- Ingestion (scripts/ingest.py): how raw documents become stored pages ---
# INGEST_DPI=200            PDF rasterization
# INGEST_MAX_LONG_EDGE=2400 ceiling of the STORED page (0 = none); elongated pages by area (~6 MP)
# INGEST_JPEG_QUALITY=92    pages that come from photos are stored as JPEG

# --- HTTP API (uvicorn --factory docextract.api.app:create_app) ---
# Documents in flight at once across ALL requests. Parallel calls burn a provider's per-minute and
# per-day quota (and the cost cap overshoots by up to this many calls), so keep it low on a limited key.
# API_CONCURRENCY=4
# API_MAX_BATCH=20          # documents per /extract/batch request
# API_MAX_UPLOAD_MB=25      # per uploaded file
# API_TOKEN=                # set it and /extract* needs "Authorization: Bearer <token>" (the eval
#                             service reads the same variable and sends it)
# CALL_LOG_PATH=outputs/logs/calls.jsonl   # one JSON line per request: tokens, cost, latency
#                             (docker-compose.yml sets it to /app/outputs/logs/calls.jsonl)

# --- Pre-labeling (scripts/prelabel.py): a DIFFERENT model drafts labels that a human verifies ---
# Only used to draft ground truth, through the same client class. It must not be the extractor's own
# model (the script refuses that: a draft by the model later evaluated would turn its own mistakes
# into ground truth). Example: Claude Haiku via Anthropic's OpenAI-compatible endpoint. That
# endpoint rejects response_format json_object and Claude 5.x rejects temperature, so the schema goes
# in the prompt only (PRELABEL_STRUCTURED_MODE=prompt, the default) and PRELABEL_SEND_TEMPERATURE=false.
PRELABEL_BASE_URL=https://api.anthropic.com/v1/
PRELABEL_API_KEY=your-anthropic-api-key
PRELABEL_MODEL=claude-haiku-5-5
PRELABEL_PRICE_INPUT_PER_MTOK=0.10
PRELABEL_PRICE_OUTPUT_PER_MTOK=0.50
PRELABEL_SEND_TEMPERATURE=false
PRELABEL_MAX_RUN_COST_USD=0.25
# PRELABEL_STRUCTURED_MODE=prompt   # prompt | json_object | json_schema | auto
# PRELABEL_IMAGE_MAX_LONG_EDGE=1568
# PRELABEL_MAX_PAGES=15        # a longer bundle must be split first (page_range in the manifest)
# PRELABEL_MAX_TOKENS=8000

# --- Alternatives that were tried (replace the extractor block above) ---
# GLM 5.3 Flash through the same provider: LLM_MODEL=z-ai/glm-5.3-flash, prices 0.15 / 0.50, json_object.
#   Same accuracy but a 7x slower median (122 s, p95 586 s): too slow for a synchronous API.
# Gemini via Google AI Studio: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   with json_schema accepted. Its free tier allows ~20 requests per day per model and every 503 and
#   retry counts; set LLM_MAX_RETRIES=0 or 1 there. Thinking tokens are billed outside completion_tokens.
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=<a vision model>,
#   prices 0. Not run here: the author's GPU (4 GB) cannot serve a useful vision model. Under Docker
#   the API runs in a container, where localhost is the container itself: use
#   http://host.docker.internal:11434/v1 instead.
